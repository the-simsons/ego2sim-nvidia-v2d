+def _pick_wilor_box(
+    wilor_raw_dir: str, frame_idx: int, mask: np.ndarray, min_mask_frac: float = 0.1,
+) -> tuple[float, float, float] | None:
+    """Return (cx, cy, side) of the WiLoR hand box that best sits inside ``mask``.
+
+    SAM2 hand masks include the forearm, so their centroid/bbox describe the
+    arm rather than the hand. WiLoR's per-frame detections are hand-sized. The
+    two hand masks never overlap, so a detection is assigned to a track by the
+    fraction of its box covered by that track's mask, provided the box centre
+    lies inside the mask. WiLoR boxes are loose (typically only ~30% mask
+    coverage) so the threshold is low; the other hand's mask covers 0% of a
+    given box. WiLoR's own handedness label is not used for localisation.
+    """
+    path = os.path.join(wilor_raw_dir, f"{frame_idx:06d}.json")
+    if not os.path.exists(path):
+        return None
+    with open(path) as f:
+        dets = json.load(f)
+    H, W = mask.shape
+    best, best_frac = None, min_mask_frac
+    for det in dets:
+        b = det["bbox"]
+        x0, y0 = max(int(b["x0"]), 0), max(int(b["y0"]), 0)
+        x1, y1 = min(int(b["x1"]), W), min(int(b["y1"]), H)
+        area = (x1 - x0) * (y1 - y0)
+        if area <= 0:
+            continue
+        frac = float(mask[y0:y1, x0:x1].sum()) / area
+        cy, cx = min((y0 + y1) // 2, H - 1), min((x0 + x1) // 2, W - 1)
+        if frac > best_frac and mask[cy, cx]:
+            best_frac = frac
+            best = ((b["x0"] + b["x1"]) * 0.5, (b["y0"] + b["y1"]) * 0.5,
+                    float(max(b["x1"] - b["x0"], b["y1"] - b["y0"])))
+    return best
+
+
